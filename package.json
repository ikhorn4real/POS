{
  "name": "counterpoint-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "predev": "tsc -p shared/tsconfig.json",
    "dev": "node apps/web/node_modules/vite/bin/vite.js --config apps/web/vite.config.js",
    "dev:api": "node --watch apps/api/src/index.js",
    "lint": "oxlint apps/web apps/api shared tests",
    "test": "tsc -p shared/tsconfig.json && tsc -p tsconfig.json && node --test",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@counterpoint/shared": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  }
}
